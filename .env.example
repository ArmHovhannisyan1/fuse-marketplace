# Future frontend integration only; the existing demo does not read these values.
# Public configuration. Never put keypairs, seeds, RPC secrets, or wallet keys here.
NEXT_PUBLIC_SOLANA_RPC_URL=http://127.0.0.1:8899
NEXT_PUBLIC_SOLANA_NETWORK=localnet
# Set only to an actually deployed program ID. The local VM ID is not deployed.
NEXT_PUBLIC_FUSE_PROGRAM_ID=
