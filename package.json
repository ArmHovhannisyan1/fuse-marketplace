{
  "name": "fuse-marketplace",
  "version": "0.1.0",
  "private": true,
  "description": "Conditional group bookings, designed for Solana. Interactive frontend prototype with simulated funds.",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "typecheck": "tsc --noEmit",
